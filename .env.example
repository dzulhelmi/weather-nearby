# Copy this file to .env, or set these as environment variables on Render.
# Everything has a default, so the project runs with no configuration at all.

PORT=3000

# Public URL of the server. Change this after deploying — the alert simulator
# calls the server back through this value.
BASE_URL=http://localhost:3000

# Shared with the weather monitoring service that signs the alerts it sends us.
# Generate a new one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=demo-secret-change-in-production
